# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model ID (Default to Anthropic Claude 3.5 Sonnet on Bedrock or Amazon Nova)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Application Mode: 'live' (requires valid AWS credentials) or 'simulation' (runs realistic agro-climatic multi-agent reasoning offline)
FARMGARD_MODE=simulation
