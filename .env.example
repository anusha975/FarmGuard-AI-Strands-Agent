# ==============================================================================
# FarmGuard AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env     (Linux/macOS)
#      Copy-Item .env.example .env   (Windows PowerShell)
# 2. Fill in your AWS credentials and preferred settings below.
# 3. NEVER commit your actual .env file or AWS secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Credentials & Region Configuration
# ------------------------------------------------------------------------------
# Region where Amazon Bedrock foundation models are enabled (e.g. us-east-1, us-west-2)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Standard IAM User or Assumed Role Access Keys:
# (Leave empty if using IAM Role attached to EC2/ECS/Lambda or ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Temporary Session Token (required only if using AWS STS or AWS SSO)
# AWS_SESSION_TOKEN=

# Optional: AWS Named Profile from ~/.aws/credentials
# AWS_PROFILE=default

# ------------------------------------------------------------------------------
# 2. Amazon Bedrock Foundation Model Configuration
# ------------------------------------------------------------------------------
# Supported models for the AWS Strands Agents SDK:
# - Anthropic Claude 3.5 Sonnet (Recommended for multi-hazard reasoning):
#     anthropic.claude-3-5-sonnet-20240620-v1:0
# - Anthropic Claude 3 Haiku (Cost-optimized, low latency for SMS):
#     anthropic.claude-3-haiku-20240307-v1:0
# - Amazon Nova Pro (High accuracy, low cost):
#     amazon.nova-pro-v1:0
# - Amazon Nova Lite (Ultra low-cost bilingual generation):
#     amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ------------------------------------------------------------------------------
# 3. Application & Agro-Meteorology Settings
# ------------------------------------------------------------------------------
# Operational mode: 'live' uses real-time Open-Meteo weather telemetry;
# 'simulation' uses deterministic benchmark telemetry for offline demonstrations.
FARMGARD_MODE=live

# Default Language: 'en' for English, 'te' for Telugu (తెలుగు)
FARMGUARD_DEFAULT_LANGUAGE=en

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
